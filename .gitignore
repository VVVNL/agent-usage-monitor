# Build output
/target/
# Installer, DMG, zip and checksum output
/dist/
*.exe
*.dmg
*.msi
SHA256SUMS*.txt

# Runtime files the app writes into its data directory; never commit these
*.corrupt
startup-error.txt
diagnostics.log
notified.json
cache.json
settings.json

# Local scratch and snapshot output (examples/*_snapshot, harnesses)
*.rgba
*.size
*.out
*.log
scratch/

# Local environment
.env
.env.*
.claude/settings.local.json

# Python (scripts/)
__pycache__/
*.pyc
.venv/

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~

# Deliberately tracked (do not ignore): Cargo.lock (CI uses --locked),
# tests/fixtures/**, docs/THIRD_PARTY.md
